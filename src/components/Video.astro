---
// Numbered video figure. Files live in public/media/. Usage in MDX:
//   <Video src="/media/vi-slam/flight-demo.mp4" poster="/media/vi-slam/poster.jpg" caption="..." />
interface Props {
  src: string;
  poster?: string;
  caption: string;
}

const { src, poster, caption } = Astro.props;
---

<figure class="video">
  <div class="frame">
    <video controls preload="none" playsinline poster={poster}>
      <source src={src} type="video/mp4" />
      <a href={src}>{src}</a>
    </video>
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .video {
    margin: calc(var(--cell) * 1.5) 0;
    counter-increment: figure;
  }

  .frame {
    padding: 8px;
    background: var(--paper-raised);
    border: 1px solid var(--ink);
  }

  video {
    width: 100%;
    background: #000;
  }

  figcaption {
    margin-top: 0.5rem;
    font-size: 0.95rem;
    line-height: 1.45;
    color: var(--muted);
  }

  figcaption::before {
    content: 'Fig. ' counter(figure) '. ';
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--ink);
  }
</style>
