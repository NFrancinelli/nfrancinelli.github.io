---
// Numbered figure for project pages. Usage in MDX:
//   import arena from '../../../assets/projects/vi-slam/arena-front.png';
//   <Figure src={arena} alt="..." caption="..." />
//   <Figure pair={[{ src: a, alt: '...' }, { src: b, alt: '...' }]} caption="..." />
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

type Pic = { src: ImageMetadata; alt: string };

interface Props {
  src?: ImageMetadata;
  alt?: string;
  pair?: [Pic, Pic];
  caption: string;
  wide?: boolean;
}

const { src, alt = '', pair, caption, wide = false } = Astro.props;
const pics: Pic[] = pair ?? (src ? [{ src, alt }] : []);
---

<figure class:list={['fig', { wide, pair: pics.length > 1 }]}>
  <div class="pics">
    {pics.map((pic) => <Image src={pic.src} alt={pic.alt} width={wide ? 1400 : 1000} />)}
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .fig {
    margin: calc(var(--cell) * 1.5) 0;
    counter-increment: figure;
  }

  .pics {
    display: grid;
    gap: 8px;
    padding: 8px;
    background: var(--paper-raised);
    border: 1px solid var(--ink);
  }

  .pair .pics {
    grid-template-columns: 1fr 1fr;
  }

  @media (max-width: 599px) {
    .pair .pics {
      grid-template-columns: 1fr;
    }
  }

  .pics :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  figcaption {
    margin-top: 0.5rem;
    font-size: 0.95rem;
    line-height: 1.45;
    color: var(--muted);
  }

  figcaption::before {
    content: 'Fig. ' counter(figure) '. ';
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--ink);
  }

  @media (min-width: 1100px) {
    .wide {
      width: min(64rem, calc(100vw - 2 * var(--gutter) - var(--margin-x) - 4rem));
    }
  }
</style>
